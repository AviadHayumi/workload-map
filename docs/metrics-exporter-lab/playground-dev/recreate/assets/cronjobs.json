                    ],
                    "image": "ghcr.io/aviadhayumi/workload-map/karta-exporter:gpu-demo-randomizer-dc1350e54ee4b543710cd584c61525c195340186@sha256:81e14687b782fb51e54dedc1cb9a5d837395bcd078bfdea55ce7e19128710c40",
