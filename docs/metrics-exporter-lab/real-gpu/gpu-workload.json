{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "real-gpu-cycle",
        "namespace": "karta-metrics-workloads"
      },
      "data": {
        "gpu_cycle.py": "# SPDX-License-Identifier: Apache-2.0\n# Copyright (c) 2026 NVIDIA Corporation\nimport json,os,time,torch\nassert torch.cuda.is_available(), \"CUDA unavailable\"\ntorch.set_num_threads(1)\ndevice=torch.device(\"cuda:0\")\na=torch.randn((4096,4096),device=device,dtype=torch.float16)\nb=torch.randn_like(a);out=torch.empty_like(a)\nreserve=torch.ones((512*1024*1024,),device=device,dtype=torch.float32)\ntorch.cuda.synchronize()\nrole=os.environ[\"TEST_ROLE\"]\nprint(json.dumps({\"event\":\"ready\",\"role\":role,\"gpu\":torch.cuda.get_device_name(0),\"torch\":torch.__version__,\"cuda\":torch.version.cuda,\"allocated_bytes\":torch.cuda.memory_allocated()}),flush=True)\nphases=[(\"active\" if role==\"master\" else \"idle\",120),(\"idle\",240),(\"active\" if role==\"master\" else \"idle\",90),(\"idle\",30)]\nfor phase,duration in phases:\n print(json.dumps({\"event\":\"phase\",\"role\":role,\"phase\":phase,\"seconds\":duration,\"time\":time.time()}),flush=True)\n deadline=time.monotonic()+duration;iterations=0\n while time.monotonic()<deadline:\n  if phase==\"active\":\n   torch.mm(a,b,out=out);torch.cuda.synchronize();iterations+=1\n  else:time.sleep(1)\n print(json.dumps({\"event\":\"phase_complete\",\"phase\":phase,\"iterations\":iterations}),flush=True)\nassert torch.isfinite(out).all().item() if role==\"master\" else True\nprint(json.dumps({\"event\":\"completed\",\"role\":role}),flush=True)\n"
      }
    },
    {
      "apiVersion": "kubeflow.org/v1",
      "kind": "PyTorchJob",
      "metadata": {
        "name": "real-pytorch-cycle",
        "namespace": "karta-metrics-workloads",
        "labels": {
          "app.kubernetes.io/part-of": "karta-real-gpu-test"
        }
      },
      "spec": {
        "runPolicy": {
          "cleanPodPolicy": "None",
          "activeDeadlineSeconds": 1800,
          "ttlSecondsAfterFinished": 7200
        },
        "pytorchReplicaSpecs": {
          "Master": {
            "replicas": 1,
            "restartPolicy": "Never",
            "template": {
              "spec": {
                "runtimeClassName": "nvidia",
                "terminationGracePeriodSeconds": 10,
                "containers": [
                  {
                    "name": "pytorch",
                    "image": "docker.io/pytorch/pytorch@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755",
                    "command": [
                      "python",
                      "/test/gpu_cycle.py"
                    ],
                    "env": [
                      {
                        "name": "TEST_ROLE",
                        "value": "master"
                      },
                      {
                        "name": "PYTHONUNBUFFERED",
                        "value": "1"
                      }
                    ],
                    "resources": {
                      "requests": {
                        "cpu": "500m",
                        "memory": "2Gi",
                        "nvidia.com/gpu": 1
                      },
                      "limits": {
                        "memory": "4Gi",
                        "nvidia.com/gpu": 1
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "test",
                        "mountPath": "/test",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "test",
                    "configMap": {
                      "name": "real-gpu-cycle"
                    }
                  }
                ]
              }
            }
          },
          "Worker": {
            "replicas": 1,
            "restartPolicy": "Never",
            "template": {
              "spec": {
                "runtimeClassName": "nvidia",
                "terminationGracePeriodSeconds": 10,
                "containers": [
                  {
                    "name": "pytorch",
                    "image": "docker.io/pytorch/pytorch@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755",
                    "command": [
                      "python",
                      "/test/gpu_cycle.py"
                    ],
                    "env": [
                      {
                        "name": "TEST_ROLE",
                        "value": "worker"
                      },
                      {
                        "name": "PYTHONUNBUFFERED",
                        "value": "1"
                      }
                    ],
                    "resources": {
                      "requests": {
                        "cpu": "500m",
                        "memory": "2Gi",
                        "nvidia.com/gpu": 1
                      },
                      "limits": {
                        "memory": "4Gi",
                        "nvidia.com/gpu": 1
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "test",
                        "mountPath": "/test",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "test",
                    "configMap": {
                      "name": "real-gpu-cycle"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}