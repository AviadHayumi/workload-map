{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "demo-first-job",
    "namespace": "karta-metrics-workloads",
    "labels": {
      "app.kubernetes.io/part-of": "karta-demo",
      "example.com/team": "exporter-demo"
    }
  },
  "spec": {
    "ttlSecondsAfterFinished": 1200,
    "backoffLimit": 0,
    "activeDeadlineSeconds": 180,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "karta-demo",
          "example.com/team": "exporter-demo",
          "app": "finite-job"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "worker",
            "image": "docker.io/library/python:3.13-alpine@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8",
            "command": [
              "python",
              "-u",
              "-c",
              "import time, os\nprint(\"Karta ownership demo: CPU work; GPU requests use the cluster's simulated devices\", flush=True)\nend=time.monotonic()+int(os.getenv(\"DURATION_SECONDS\",\"864000\"))\nmemory=bytearray(16*1024*1024)\nwhile time.monotonic()<end:\n    sum(i*i for i in range(18000))\n    time.sleep(0.05)\nprint(\"Completed\",flush=True)\n"
            ],
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "250m",
                "memory": "96Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "env": [
              {
                "name": "DURATION_SECONDS",
                "value": "60"
              }
            ]
          }
        ],
        "restartPolicy": "Never"
      }
    }
  }
}
