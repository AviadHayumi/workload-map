{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "annotations": {},
        "name": "finite-workload-submitter",
        "namespace": "karta-metrics-poc"
      },
      "spec": {
        "concurrencyPolicy": "Forbid",
        "failedJobsHistoryLimit": 2,
        "jobTemplate": {
          "metadata": {},
          "spec": {
            "activeDeadlineSeconds": 60,
            "backoffLimit": 1,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "finite-workload-submitter"
                }
              },
              "spec": {
                "containers": [
                  {
                    "args": [
                      "--namespace=karta-finite-workloads"
                    ],
                    "env": [
                      {
                        "name": "POD_UID",
                        "valueFrom": {
                          "fieldRef": {
                            "apiVersion": "v1",
                            "fieldPath": "metadata.uid"
                          }
                        }
                      }
                    ],
                    "image": "ghcr.io/aviadhayumi/workload-map/karta-exporter@sha256:cda1b402f0ac9078ee7e7ee5ce4baec140111040d7ecba8767700664dce68495",
                    "imagePullPolicy": "IfNotPresent",
                    "name": "submitter",
                    "resources": {
                      "limits": {
                        "cpu": "200m",
                        "memory": "128Mi"
                      },
                      "requests": {
                        "cpu": "25m",
                        "memory": "64Mi"
                      }
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "readOnlyRootFilesystem": true
                    },
                    "terminationMessagePath": "/dev/termination-log",
                    "terminationMessagePolicy": "File"
                  }
                ],
                "dnsPolicy": "ClusterFirst",
                "restartPolicy": "Never",
                "schedulerName": "default-scheduler",
                "securityContext": {
                  "runAsGroup": 65532,
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "serviceAccount": "finite-workload-submitter",
                "serviceAccountName": "finite-workload-submitter",
                "terminationGracePeriodSeconds": 30
              }
            },
            "ttlSecondsAfterFinished": 1200
          }
        },
        "schedule": "*/5 * * * *",
        "startingDeadlineSeconds": 30,
        "successfulJobsHistoryLimit": 2,
        "suspend": false,
        "timeZone": "Etc/UTC"
      }
    },
    {
