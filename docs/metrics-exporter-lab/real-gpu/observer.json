{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "annotations": {},
    "labels": {
      "app": "karta-workload-gpu-observer",
      "app.kubernetes.io/part-of": "karta-metrics-poc"
    },
    "name": "karta-workload-gpu-observer",
    "namespace": "karta-metrics-poc"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "karta-workload-gpu-observer"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "karta-workload-gpu-observer",
          "app.kubernetes.io/part-of": "karta-metrics-poc"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "--source-url=http://nvidia-dcgm-exporter.gpu-operator.svc:9400/metrics",
              "--karta-url=http://karta-exporter.karta-metrics-poc.svc:8080/metrics",
              "--namespace=karta-metrics-workloads",
              "--node=__GPU_NODE__",
              "--window=180s",
              "--threshold-ratio=0.05",
              "--poll-interval=10s",
              "--max-gap=25s",
              "--native-dcgm"
            ],
            "image": "ghcr.io/aviadhayumi/workload-map/karta-exporter@sha256:532e2dfdd0117da8c8132adb2751710b91c91e3833b424cacffb955bc4acbee5",
            "imagePullPolicy": "IfNotPresent",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/healthz",
                "port": "metrics",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "name": "karta-workload-gpu-observer",
            "ports": [
              {
                "containerPort": 9092,
                "name": "metrics",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "path": "/healthz",
                "port": "metrics",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 2,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "resources": {
              "limits": {
                "cpu": "250m",
                "memory": "128Mi"
              },
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccount": "karta-workload-gpu-observer",
        "serviceAccountName": "karta-workload-gpu-observer",
        "terminationGracePeriodSeconds": 30
      }
    }
  }
}
