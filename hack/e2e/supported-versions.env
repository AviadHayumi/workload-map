#
# The operator versions the matrix maintains: for each operator, the newest
# patch of every release line its maintainers still support. This file is the
# commitment - record-matrix.sh <operator> all records exactly these.
# real-data/ may hold more versions recorded along the way; those are kept as
# evidence, not as a support statement.
# Each operator links the release page its maintainers publish, so bumping the
# list when a new version ships is one lookup.

# kubernetes-sigs; SECURITY.md defers to the Kubernetes skew policy, release
# practice is patches on the newest minor only.
# Releases: https://github.com/kubernetes-sigs/jobset/releases
JOBSET_MATRIX="v0.12.0"

# kubernetes-sigs; SECURITY.md defers to the Kubernetes skew policy, release
# practice is patches on the newest minor only.
# Releases: https://github.com/kubernetes-sigs/lws/releases
LWS_MATRIX="v0.10.0"

# Patches land on the newest minor only.
# Releases: https://github.com/ray-project/kuberay/releases
KUBERAY_MATRIX="1.7.0"

# SECURITY.md: release branches for the most recent two minor releases -
# today that is the v2 line (TrainJob), a new API generation outside these
# flows; v1.9 is the newest line that serves the recorded APIs.
# Releases: https://github.com/kubeflow/trainer/releases
KUBEFLOW_MATRIX="v1.9.4"

# Knative documents support for its most recent releases (about twelve
# months, four quarterly releases); one entry per supported minor, as
# serving:kourier pairs.
# Releases: https://github.com/knative/serving/releases
# Kourier:  https://github.com/knative/net-kourier/releases
KNATIVE_MATRIX="knative-v1.23.0:knative-v1.23.0 knative-v1.22.1:knative-v1.22.1 knative-v1.21.3:knative-v1.21.1 knative-v1.20.3:knative-v1.20.1"

# SECURITY.md: security updates for the latest release and the preceding one.
# Releases: https://github.com/kserve/kserve/releases
KSERVE_MATRIX="v0.20.0 v0.19.0"

# Patches land on the newest 1.3.x.
# Releases: https://github.com/zilliztech/milvus-operator/releases
MILVUS_MATRIX="1.3.9"

# Alpha line, no support policy upstream yet; the newest alpha is tracked.
# Releases: https://github.com/ai-dynamo/grove/releases
GROVE_MATRIX="v0.1.0-alpha.13"

# Upstream supports the 1.4 line, which dropped the v1alpha1 CR these flows
# submit (see real-data/SKIPPED.md); 1.2.1 is the newest version the flows can
# record until they move to v1beta1.
# Releases: https://github.com/ai-dynamo/dynamo/releases
DYNAMO_MATRIX="1.2.1"

# NVIDIA maintains the newest release line.
# Releases: https://github.com/NVIDIA/k8s-nim-operator/releases
NIM_MATRIX="v3.1.2"
