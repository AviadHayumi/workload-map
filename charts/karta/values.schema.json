{
  "$comment": "SPDX-License-Identifier: Apache-2.0\nCopyright (c) 2026 NVIDIA Corporation",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "exporter": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "if": {
        "$comment": "Use the same truthiness check as the exporter templates.",
        "required": ["enabled"],
        "properties": {
          "enabled": {"not": {"enum": [false, null, 0, "", [], {}]}}
        }
      },
      "then": {
        "required": ["selection", "metrics", "tuning"],
        "properties": {
          "selection": {"type": "object"},
          "metrics": {"type": "object"},
          "tuning": {
            "type": "object",
            "required": ["workers", "apiClient"],
            "properties": {
              "workers": {"type": "object"},
              "apiClient": {"type": "object"}
            }
          }
        }
      },
      "properties": {
        "enabled": {},
        "selection": {},
        "kartaDefinitionSource": {},
        "metrics": {},
        "metricsPort": {},
        "serviceMonitor": {},
        "rbac": {},
        "image": {},
        "resources": {},
        "nodeSelector": {},
        "tolerations": {},
        "affinity": {},
        "podLabels": {},
        "podAnnotations": {},
        "service": {},
        "tuning": {}
      }
    }
  }
}
