{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "resource.k8s.io/v1",
      "kind": "ResourceClaimTemplate",
      "metadata": {
        "name": "real-dra-full",
        "namespace": "karta-metrics-workloads"
      },
      "spec": {
        "spec": {
          "devices": {
            "requests": [
              {
                "name": "gpu",
                "exactly": {
                  "deviceClassName": "gpu.nvidia.com",
                  "allocationMode": "ExactCount",
                  "count": 1,
                  "selectors": [
                    {
                      "cel": {
                        "expression": "device.attributes['gpu.nvidia.com'].productName == 'NVIDIA A100-PCIE-40GB'"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "resource.k8s.io/v1",
      "kind": "ResourceClaimTemplate",
      "metadata": {
        "name": "real-dra-mig",
        "namespace": "karta-metrics-workloads"
      },
      "spec": {
        "spec": {
          "devices": {
            "requests": [
              {
                "name": "gpu",
                "exactly": {
                  "deviceClassName": "mig.nvidia.com",
                  "allocationMode": "ExactCount",
                  "count": 1,
                  "selectors": [
                    {
                      "cel": {
                        "expression": "device.attributes['gpu.nvidia.com'].profile == '3g.20gb'"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
