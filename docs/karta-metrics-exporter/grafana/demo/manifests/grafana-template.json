{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "karta-grafana",
        "namespace": "monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "karta-demo"
        }
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "karta-grafana"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "karta-grafana"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "GF_SERVER_ROOT_URL",
                    "value": "https://__GRAFANA_HOST__/karta/grafana/"
                  },
                  {
                    "name": "GF_SERVER_SERVE_FROM_SUB_PATH",
                    "value": "true"
                  },
                  {
                    "name": "GF_SECURITY_COOKIE_SECURE",
                    "value": "true"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
                    "value": "Viewer"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ORG_NAME",
                    "value": "Main Org."
                  },
                  {
                    "name": "GF_USERS_VIEWERS_CAN_EDIT",
                    "value": "false"
                  },
                  {
                    "name": "GF_USERS_ALLOW_SIGN_UP",
                    "value": "false"
                  },
                  {
                    "name": "GF_ANALYTICS_REPORTING_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "GF_ANALYTICS_CHECK_FOR_UPDATES",
                    "value": "false"
                  },
                  {
                    "name": "GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH",
                    "value": "/var/lib/grafana/dashboards/karta.json"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_USER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "username",
                        "name": "karta-monitoring-admin"
                      }
                    }
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "password",
                        "name": "karta-monitoring-admin"
                      }
                    }
                  },
                  {
                    "name": "GF_AUTH_DISABLE_LOGIN_FORM",
                    "value": "true"
                  }
                ],
                "image": "docker.io/grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/karta/grafana/api/health",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 60,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "grafana",
                "ports": [
                  {
                    "containerPort": 3000,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/karta/grafana/api/health",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "memory": "2Gi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/var/lib/grafana",
                    "name": "storage"
                  },
                  {
                    "mountPath": "/var/lib/grafana/dashboards",
                    "name": "dashboards"
                  },
                  {
                    "mountPath": "/etc/grafana/provisioning/datasources/datasources.yaml",
                    "name": "provisioning",
                    "subPath": "datasources.yaml"
                  },
                  {
                    "mountPath": "/etc/grafana/provisioning/dashboards/dashboards.yaml",
                    "name": "provisioning",
                    "subPath": "dashboards.yaml"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 472,
              "runAsGroup": 472,
              "runAsNonRoot": true,
              "runAsUser": 472
            },
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "storage",
                "persistentVolumeClaim": {
                  "claimName": "karta-grafana"
                }
              },
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "karta-grafana-dashboard"
                },
                "name": "dashboards"
              },
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "karta-grafana-provisioning"
                },
                "name": "provisioning"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "karta-grafana",
        "namespace": "monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "karta-demo"
        }
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 3000,
            "protocol": "TCP",
            "targetPort": "http"
          }
        ],
        "selector": {
          "app": "karta-grafana"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "data": {
        "dashboards.yaml": "apiVersion: 1\nproviders:\n- disableDeletion: false\n  editable: true\n  folder: Karta\n  name: Karta\n  options:\n    path: /var/lib/grafana/dashboards\n  orgId: 1\n  type: file\n",
        "datasources.yaml": "apiVersion: 1\ndatasources:\n- access: proxy\n  editable: false\n  isDefault: true\n  jsonData:\n    httpMethod: POST\n    timeInterval: 30s\n  name: Karta Prometheus\n  type: prometheus\n  uid: karta-prometheus\n  url: __PROMETHEUS_URL__\n"
      },
      "kind": "ConfigMap",
      "metadata": {
        "name": "karta-grafana-provisioning",
        "namespace": "monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "karta-demo"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "karta-grafana",
        "namespace": "monitoring",
        "labels": {
          "app.kubernetes.io/part-of": "karta-demo"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        },
        "storageClassName": "__STORAGE_CLASS__",
        "volumeMode": "Filesystem"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "karta-grafana",
        "namespace": "monitoring",
        "annotations": {
          "nginx.ingress.kubernetes.io/proxy-body-size": "8m"
        }
      },
      "spec": {
        "ingressClassName": "__INGRESS_CLASS__",
        "tls": [
          {
            "hosts": [
              "__GRAFANA_HOST__"
            ],
            "secretName": "__TLS_SECRET_NAME__"
          }
        ],
        "rules": [
          {
            "host": "__GRAFANA_HOST__",
            "http": {
              "paths": [
                {
                  "path": "/karta/grafana",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "karta-grafana",
                      "port": {
                        "number": 3000
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
