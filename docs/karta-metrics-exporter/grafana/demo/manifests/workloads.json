      "data": {
        "generate.py": "import json, ssl, time, urllib.request\nfrom pathlib import Path\nsa=Path('/var/run/secrets/kubernetes.io/serviceaccount')\ncontext=ssl.create_default_context(cafile=str(sa/'ca.crt'))\ntoken=(sa/'token').read_text().strip()\nbase='https://kubernetes.default.svc'\ndef create(path, obj):\n    request=urllib.request.Request(base+path,data=json.dumps(obj).encode(),headers={'Authorization':'Bearer '+token,'Content-Type':'application/json'},method='POST')\n    with urllib.request.urlopen(request,context=context,timeout=30) as response:\n        result=json.load(response)\n    print('Created',result['kind'],result['metadata']['name'],flush=True)\ncreate('/apis/batch/v1/namespaces/karta-metrics-workloads/jobs',json.loads(Path('/templates/job.json').read_text()))\nif (int(time.time())//120)%3==0:\n    create('/apis/kubeflow.org/v1/namespaces/karta-metrics-workloads/pytorchjobs',json.loads(Path('/templates/pytorch.json').read_text()))\n",
        "job.json": "{\"apiVersion\": \"batch/v1\", \"kind\": \"Job\", \"metadata\": {\"generateName\": \"demo-job-\", \"namespace\": \"karta-metrics-workloads\", \"labels\": {\"app.kubernetes.io/part-of\": \"karta-demo\", \"example.com/team\": \"exporter-demo\"}}, \"spec\": {\"ttlSecondsAfterFinished\": 1200, \"backoffLimit\": 0, \"activeDeadlineSeconds\": 180, \"template\": {\"metadata\": {\"labels\": {\"app.kubernetes.io/part-of\": \"karta-demo\", \"example.com/team\": \"exporter-demo\", \"app\": \"finite-job\"}}, \"spec\": {\"automountServiceAccountToken\": false, \"securityContext\": {\"runAsNonRoot\": true, \"runAsUser\": 65532, \"seccompProfile\": {\"type\": \"RuntimeDefault\"}}, \"containers\": [{\"name\": \"worker\", \"image\": \"docker.io/library/python:3.13-alpine@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8\", \"command\": [\"python\", \"-u\", \"-c\", \"import time, os\\nprint(\\\"Karta ownership demo: CPU work; GPU requests use the cluster's simulated devices\\\", flush=True)\\nend=time.monotonic()+int(os.getenv(\\\"DURATION_SECONDS\\\",\\\"864000\\\"))\\nmemory=bytearray(16*1024*1024)\\nwhile time.monotonic()<end:\\n    sum(i*i for i in range(18000))\\n    time.sleep(0.05)\\nprint(\\\"Completed\\\",flush=True)\\n\"], \"resources\": {\"requests\": {\"cpu\": \"50m\", \"memory\": \"32Mi\"}, \"limits\": {\"cpu\": \"250m\", \"memory\": \"96Mi\"}}, \"securityContext\": {\"allowPrivilegeEscalation\": false, \"readOnlyRootFilesystem\": true, \"capabilities\": {\"drop\": [\"ALL\"]}}, \"env\": [{\"name\": \"DURATION_SECONDS\", \"value\": \"60\"}]}], \"restartPolicy\": \"Never\"}}}}",
        "pytorch.json": "{\"apiVersion\": \"kubeflow.org/v1\", \"kind\": \"PyTorchJob\", \"metadata\": {\"generateName\": \"demo-finite-pytorch-\", \"namespace\": \"karta-metrics-workloads\", \"labels\": {\"app.kubernetes.io/part-of\": \"karta-demo\", \"example.com/team\": \"exporter-demo\"}}, \"spec\": {\"runPolicy\": {\"cleanPodPolicy\": \"None\", \"ttlSecondsAfterFinished\": 1200, \"activeDeadlineSeconds\": 240}, \"pytorchReplicaSpecs\": {\"Master\": {\"replicas\": 1, \"restartPolicy\": \"Never\", \"template\": {\"metadata\": {\"labels\": {\"app.kubernetes.io/part-of\": \"karta-demo\", \"example.com/team\": \"exporter-demo\", \"app\": \"finite-pytorch\"}}, \"spec\": {\"automountServiceAccountToken\": false, \"securityContext\": {\"runAsNonRoot\": true, \"runAsUser\": 65532, \"seccompProfile\": {\"type\": \"RuntimeDefault\"}}, \"containers\": [{\"name\": \"pytorch\", \"image\": \"docker.io/library/python:3.13-alpine@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8\", \"command\": [\"python\", \"-u\", \"-c\", \"import time, os\\nprint(\\\"Karta ownership demo: CPU work; GPU requests use the cluster's simulated devices\\\", flush=True)\\nend=time.monotonic()+int(os.getenv(\\\"DURATION_SECONDS\\\",\\\"864000\\\"))\\nmemory=bytearray(16*1024*1024)\\nwhile time.monotonic()<end:\\n    sum(i*i for i in range(18000))\\n    time.sleep(0.05)\\nprint(\\\"Completed\\\",flush=True)\\n\"], \"resources\": {\"requests\": {\"cpu\": \"50m\", \"memory\": \"32Mi\", \"nvidia.com/gpu\": 1}, \"limits\": {\"cpu\": \"250m\", \"memory\": \"96Mi\", \"nvidia.com/gpu\": 1}}, \"securityContext\": {\"allowPrivilegeEscalation\": false, \"readOnlyRootFilesystem\": true, \"capabilities\": {\"drop\": [\"ALL\"]}}, \"env\": [{\"name\": \"DURATION_SECONDS\", \"value\": \"75\"}]}], \"restartPolicy\": \"Never\"}}}, \"Worker\": {\"replicas\": 1, \"restartPolicy\": \"Never\", \"template\": {\"metadata\": {\"labels\": {\"app.kubernetes.io/part-of\": \"karta-demo\", \"example.com/team\": \"exporter-demo\", \"app\": \"finite-pytorch\"}}, \"spec\": {\"automountServiceAccountToken\": false, \"securityContext\": {\"runAsNonRoot\": true, \"runAsUser\": 65532, \"seccompProfile\": {\"type\": \"RuntimeDefault\"}}, \"containers\": [{\"name\": \"pytorch\", \"image\": \"docker.io/library/python:3.13-alpine@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8\", \"command\": [\"python\", \"-u\", \"-c\", \"import time, os\\nprint(\\\"Karta ownership demo: CPU work; GPU requests use the cluster's simulated devices\\\", flush=True)\\nend=time.monotonic()+int(os.getenv(\\\"DURATION_SECONDS\\\",\\\"864000\\\"))\\nmemory=bytearray(16*1024*1024)\\nwhile time.monotonic()<end:\\n    sum(i*i for i in range(18000))\\n    time.sleep(0.05)\\nprint(\\\"Completed\\\",flush=True)\\n\"], \"resources\": {\"requests\": {\"cpu\": \"50m\", \"memory\": \"32Mi\", \"nvidia.com/gpu\": 1}, \"limits\": {\"cpu\": \"250m\", \"memory\": \"96Mi\", \"nvidia.com/gpu\": 1}}, \"securityContext\": {\"allowPrivilegeEscalation\": false, \"readOnlyRootFilesystem\": true, \"capabilities\": {\"drop\": [\"ALL\"]}}, \"env\": [{\"name\": \"DURATION_SECONDS\", \"value\": \"75\"}]}], \"restartPolicy\": \"Never\"}}}}}}"
