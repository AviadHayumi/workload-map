{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "real-dra-full-probe",
        "namespace": "karta-metrics-workloads",
        "labels": {
          "app.kubernetes.io/part-of": "karta-real-gpu-test"
        }
      },
      "spec": {
        "activeDeadlineSeconds": 300,
        "backoffLimit": 0,
        "ttlSecondsAfterFinished": 7200,
        "template": {
          "spec": {
            "runtimeClassName": "nvidia",
            "terminationGracePeriodSeconds": 10,
            "containers": [
              {
                "name": "pytorch",
                "image": "docker.io/pytorch/pytorch@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755",
                "command": [
                  "python",
                  "-c",
                  "import torch,json,time; assert torch.cuda.is_available(); assert torch.cuda.device_count()==1; a=torch.randn((2048,2048),device=\"cuda\"); b=a@a; torch.cuda.synchronize(); assert torch.isfinite(b).all(); print(json.dumps({\"cuda\":True,\"device\":torch.cuda.get_device_name(0),\"device_count\":torch.cuda.device_count(),\"bytes\":torch.cuda.get_device_properties(0).total_memory}),flush=True); time.sleep(45)"
                ],
                "env": [
                  {
                    "name": "TEST_ROLE",
                    "value": "master"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  },
                  {
                    "name": "NVIDIA_VISIBLE_DEVICES",
                    "value": "void"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "500m",
                    "memory": "2Gi"
                  },
                  "limits": {
                    "memory": "4Gi"
                  },
                  "claims": [
                    {
                      "name": "gpu"
                    }
                  ]
                },
                "volumeMounts": [
                  {
                    "name": "test",
                    "mountPath": "/test",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "test",
                "configMap": {
                  "name": "real-gpu-cycle"
                }
              }
            ],
            "restartPolicy": "Never",
            "resourceClaims": [
              {
                "name": "gpu",
                "resourceClaimTemplateName": "real-dra-full"
              }
            ]
          },
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "karta-real-gpu-test",
              "app.kubernetes.io/name": "real-gpu-cycle"
            }
          }
        }
      }
    },
